# ===================================================================
# EventEase - environment configuration
# Copy this file to `.env` and adjust the values.
# ===================================================================

# --- Database -------------------------------------------------------
# Primary target: MySQL 8.0
DATABASE_URL=mysql+pymysql://eventease:eventease@127.0.0.1:3306/eventease

# Zero-setup alternative (development / demo without a MySQL server):
# DATABASE_URL=sqlite:///./eventease.db

# Echo every SQL statement in the log (handy for the viva, noisy in production)
SQL_ECHO=false

# --- Application ----------------------------------------------------
DEBUG=false
AUTO_INIT_DB=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Frontend -------------------------------------------------------
# Leave empty so that the Vite dev-server proxy is used.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000
